# ==============================================================================
# KEK INDONESIA INFORMATION & INVESTMENT PORTAL
# Environment Variables Configuration
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL)
# Format: postgresql://[user]:[password]@[neon_host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL for Prisma Migrations (Bypasses Neon connection pooler for schema migration tasks)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (Auth.js / NextAuth v5)
# Generate a secret via: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="development-secret-kek-portal-2026-secure-token-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_NAME="Portal Informasi & Investasi KEK Indonesia"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
